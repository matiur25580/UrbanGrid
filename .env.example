# API
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
API_PREFIX=/api/v1
LOG_LEVEL=info

# Database (required before database-backed modules are enabled)
MONGODB_URI=mongodb://127.0.0.1:27017/urbangrid

# Security: replace with a cryptographically random value (minimum 32 characters)
JWT_ACCESS_SECRET=replace-with-a-long-random-development-secret
ACCESS_TOKEN_TTL=15m
