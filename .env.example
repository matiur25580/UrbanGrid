# API
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
API_PREFIX=/api/v1
LOG_LEVEL=info

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/urbangrid

# Generate a unique secret: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
